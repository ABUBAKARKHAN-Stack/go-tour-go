diff --git a/src/lib/local-data-schema.ts b/src/lib/local-data-schema.ts
new file mode 100644
index 0000000..bb23b08
--- /dev/null
+++ b/src/lib/local-data-schema.ts
@@ -0,0 +1,77 @@
+/**
+ * The on-device landmark and place tables (pure: no React Native), shared by
+ * the app's sync and by scripts/build-offline-db.ts, which builds the
+ * database bundled with the app. Both must write rows the same way, so the
+ * row mapping (including the normalised search name) lives here once.
+ */
+import { squash } from '@/features/data/search-text';
+import type { DestinationSummary, Place } from '@/lib/types';
+
+export const LOCAL_SCHEMA = `
+CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY NOT NULL, value TEXT);
+CREATE TABLE IF NOT EXISTS places (
+  id TEXT PRIMARY KEY NOT NULL,
+  name TEXT NOT NULL,
+  name_norm TEXT NOT NULL,
+  name_ur TEXT,
+  kind TEXT NOT NULL,
+  district TEXT,
+  province TEXT,
+  latitude REAL NOT NULL,
+  longitude REAL NOT NULL,
+  rank INTEGER NOT NULL DEFAULT 0
+);
+CREATE INDEX IF NOT EXISTS places_name_norm ON places (name_norm);
+CREATE TABLE IF NOT EXISTS destinations (
+  id TEXT PRIMARY KEY NOT NULL,
+  slug TEXT NOT NULL,
+  name TEXT NOT NULL,
+  name_norm TEXT NOT NULL,
+  name_ur TEXT,
+  category TEXT NOT NULL,
+  city TEXT NOT NULL,
+  region TEXT NOT NULL,
+  latitude REAL NOT NULL,
+  longitude REAL NOT NULL,
+  radius_m INTEGER NOT NULL,
+  short_description TEXT NOT NULL,
+  image_url TEXT,
+  featured INTEGER NOT NULL,
+  source TEXT NOT NULL
+);
+CREATE INDEX IF NOT EXISTS destinations_name_norm ON destinations (name_norm);
+`;
+
+/** What is read from the server for each table. */
+export const PLACE_COLUMNS = 'id,name,name_ur,kind,district,province,latitude,longitude,rank';
+export const DESTINATION_COLUMNS =
+  'id,slug,name,name_ur,category,city,region,latitude,longitude,radius_m,short_description,image_url,featured,source';
+
+/** Local columns, in the order of the row arrays below. */
+export const PLACE_INSERT_COLUMNS = 'id,name,name_norm,name_ur,kind,district,province,latitude,longitude,rank';
+export const DESTINATION_INSERT_COLUMNS =
+  'id,slug,name,name_norm,name_ur,category,city,region,latitude,longitude,radius_m,short_description,image_url,featured,source';
+
+export function placeRow(p: Place) {
+  return [p.id, p.name, squash(p.name), p.name_ur, p.kind, p.district, p.province, p.latitude, p.longitude, p.rank];
+}
+
+export function destinationRow(d: DestinationSummary) {
+  return [
+    d.id,
+    d.slug,
+    d.name,
+    squash(d.name),
+    d.name_ur,
+    d.category,
+    d.city,
+    d.region,
+    d.latitude,
+    d.longitude,
+    d.radius_m,
+    d.short_description,
+    d.image_url,
+    d.featured ? 1 : 0,
+    d.source,
+  ];
+}
