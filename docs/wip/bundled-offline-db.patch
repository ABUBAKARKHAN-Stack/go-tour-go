+import { DESTINATION_INSERT_COLUMNS, LOCAL_SCHEMA, PLACE_INSERT_COLUMNS } from './local-data-schema';
 
 /**
  * On-device copy of Pakistan's places and landmarks, so search, the map and
- * proximity alerts work without a connection. Filled by features/data/sync.ts.
- * Separate from the kv-store database used for small settings.
+ * proximity alerts work without a connection. A copy ships inside the app
+ * (assets/data/gotourgo-data.db, built by scripts/build-offline-db.ts), so
+ * the very first launch works offline; features/data/sync.ts then keeps it
+ * up to date. Separate from the kv-store database used for small settings.
  */
 const SCHEMA = `
 PRAGMA journal_mode = WAL;
-CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY NOT NULL, value TEXT);
-CREATE TABLE IF NOT EXISTS places (
-  id TEXT PRIMARY KEY NOT NULL,
-  name TEXT NOT NULL,
-  name_norm TEXT NOT NULL,
-  name_ur TEXT,
-  kind TEXT NOT NULL,
-  district TEXT,
-  province TEXT,
-  latitude REAL NOT NULL,
-  longitude REAL NOT NULL,
-  rank INTEGER NOT NULL DEFAULT 0
-);
-CREATE INDEX IF NOT EXISTS places_name_norm ON places (name_norm);
-CREATE TABLE IF NOT EXISTS destinations (
-  id TEXT PRIMARY KEY NOT NULL,
-  slug TEXT NOT NULL,
-  name TEXT NOT NULL,
-  name_norm TEXT NOT NULL,
-  name_ur TEXT,
-  category TEXT NOT NULL,
-  city TEXT NOT NULL,
-  region TEXT NOT NULL,
-  latitude REAL NOT NULL,
-  longitude REAL NOT NULL,
-  radius_m INTEGER NOT NULL,
-  short_description TEXT NOT NULL,
-  image_url TEXT,
-  featured INTEGER NOT NULL,
-  source TEXT NOT NULL
-);
-CREATE INDEX IF NOT EXISTS destinations_name_norm ON destinations (name_norm);
-`;
+${LOCAL_SCHEMA}`;
 
 let db: SQLiteDatabase | null = null;
 
@@ -73,3 +45,47 @@ export function getMeta(key: string): string | null {
 export function setMeta(key: string, value: string) {
   localDb().runSync('INSERT INTO meta (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value', key, value);
 }
+
+const BUNDLE_NAME = 'gotourgo-bundle.db';
+const TABLES = [
+  { name: 'places', columns: PLACE_INSERT_COLUMNS },
+  { name: 'destinations', columns: DESTINATION_INSERT_COLUMNS },
+] as const;
+let preparing: Promise<void> | null = null;
+
+/**
+ * Fills any empty table (first launch, or a table rebuilt after an app
+ * update) from the database bundled with the app, so places and landmarks
+ * are there before any download. Tables that already have data are left as
+ * they are; the next sync brings anything newer. Safe to call often.
+ */
+export function prepareLocalDb(): Promise<void> {
+  preparing ??= fillFromBundle().catch((e) => {
+    preparing = null; // try again next time
+    throw e;
+  });
+  return preparing;
+}
+
+async function fillFromBundle() {
+  const main = localDb();
+  const empty = TABLES.filter((t) => (main.getFirstSync<{ n: number }>(`SELECT COUNT(*) AS n FROM ${t.name}`)?.n ?? 0) === 0);
+  if (!empty.length) return;
+  // The bundled file is copied next to the main database, attached, read, and removed.
+  await importDatabaseFromAssetAsync(BUNDLE_NAME, { assetId: require('../../assets/data/gotourgo-data.db'), forceOverwrite: true });
+  const path = `${String(defaultDatabaseDirectory).replace(/\/*$/, '')}/${BUNDLE_NAME}`;
+  await main.runAsync('ATTACH DATABASE ? AS bundle', path);
+  try {
+    // Same connection as the ATTACH (an exclusive transaction would open another).
+    await main.withTransactionAsync(async () => {
+      for (const t of empty) {
+        await main.execAsync(`INSERT OR REPLACE INTO main.${t.name} (${t.columns}) SELECT ${t.columns} FROM bundle.${t.name}`);
+        // The bundle's dataset version, so a sync only downloads what changed since the app was built.
+        await main.runAsync(`INSERT OR REPLACE INTO main.meta (key, value) SELECT key, value FROM bundle.meta WHERE key = ?`, `version:${t.name}`);
+      }
+    });
+  } finally {
+    await main.execAsync('DETACH DATABASE bundle');
+    await deleteDatabaseAsync(BUNDLE_NAME).catch(() => undefined);
+  }
+}
