# Copy to .env.local for local development (never commit real values).
# For EAS cloud builds, create the same variables in the EAS "preview" and
# "development" environments (bunx eas-cli env:create ...).

# Required. Supabase project URL (Project Settings > API).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Required. Supabase publishable key (sb_publishable_...). Safe for the client; RLS protects data.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional. MapLibre style URL. Defaults to OpenFreeMap "liberty" (no key needed).
# EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Server-side secrets are NOT set here. They belong to the Supabase Edge Function:
#   supabase secrets set GEMINI_API_KEY=... [GEMINI_MODEL=...] [AI_DAILY_LIMIT=50]
